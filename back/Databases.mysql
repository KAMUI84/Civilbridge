-- ---------------------------------------------------------
-- 7) Marketplace Listings
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS listings (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  created_by BIGINT NOT NULL,
  status ENUM('DRAFT','PUBLISHED','ARCHIVED','REJECTED') NOT NULL DEFAULT 'DRAFT',
  listing_type ENUM('LAND','PROPERTY','MATERIAL','EQUIPMENT') NOT NULL DEFAULT 'LAND',
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  region VARCHAR(80) NULL,
  district VARCHAR(80) NULL,
  sector VARCHAR(80) NULL,
  address_text VARCHAR(255) NULL,
  lat DECIMAL(10,7) NULL,
  lng DECIMAL(10,7) NULL,
  size_sqm DECIMAL(12,2) NULL,
  price_currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  price_amount DECIMAL(14,2) NULL,
  ownership_type VARCHAR(50) NULL,
  contact_phone VARCHAR(40) NULL,
  contact_email VARCHAR(190) NULL,
  view_count INT NOT NULL DEFAULT 0,
  rejected_reason TEXT NULL,
  moderated_by BIGINT NULL,
  moderated_at DATETIME NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_listings_status (status),
  INDEX idx_listings_region (region),
  INDEX idx_listings_type (listing_type),
  CONSTRAINT fk_listings_user FOREIGN KEY (created_by) REFERENCES users(id),
  CONSTRAINT fk_listings_moderator FOREIGN KEY (moderated_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS listing_images (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  listing_id BIGINT NOT NULL,
  url VARCHAR(500) NOT NULL,
  alt_text VARCHAR(140) NULL,
  sort_order INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_listing_images_listing (listing_id),
  CONSTRAINT fk_listing_images_listing FOREIGN KEY (listing_id) REFERENCES listings(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 8) Plans Library
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS plans (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  created_by BIGINT NOT NULL,
  status ENUM('DRAFT','PUBLISHED','ARCHIVED','REJECTED') NOT NULL DEFAULT 'DRAFT',
  category ENUM('RESIDENTIAL','COMMERCIAL','INDUSTRIAL') NOT NULL DEFAULT 'RESIDENTIAL',
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  style VARCHAR(80) NULL,
  bedrooms INT NULL,
  bathrooms INT NULL,
  floors INT NULL,
  area_sqm DECIMAL(12,2) NULL,
  estimated_cost_min DECIMAL(14,2) NULL,
  estimated_cost_max DECIMAL(14,2) NULL,
  currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  tags VARCHAR(255) NULL,
  download_count INT NOT NULL DEFAULT 0,
  view_count INT NOT NULL DEFAULT 0,
  is_featured TINYINT(1) NOT NULL DEFAULT 0,
  rejected_reason TEXT NULL,
  moderated_by BIGINT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_plans_status (status),
  INDEX idx_plans_category (category),
  INDEX idx_plans_featured (is_featured),
  CONSTRAINT fk_plans_user FOREIGN KEY (created_by) REFERENCES users(id),
  CONSTRAINT fk_plans_moderator FOREIGN KEY (moderated_by) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS plan_images (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  plan_id BIGINT NOT NULL,
  url VARCHAR(500) NOT NULL,
  alt_text VARCHAR(140) NULL,
  sort_order INT NOT NULL DEFAULT 0,
  image_type ENUM('render','floor_plan','elevation','detail') NOT NULL DEFAULT 'render',
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_plan_images_plan (plan_id),
  CONSTRAINT fk_plan_images_plan FOREIGN KEY (plan_id) REFERENCES plans(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 9) Expert Profiles
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS expert_profiles (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT NOT NULL UNIQUE,
  headline VARCHAR(140) NULL,
  bio TEXT NULL,
  experience_years INT NULL,
  skills VARCHAR(255) NULL,
  company VARCHAR(140) NULL,
  license_id VARCHAR(80) NULL,
  region VARCHAR(80) NULL,
  specialization VARCHAR(120) NULL,
  website_url VARCHAR(255) NULL,
  phone VARCHAR(40) NULL,
  rating_avg DECIMAL(3,2) NOT NULL DEFAULT 0.00,
  rating_count INT NOT NULL DEFAULT 0,
  projects_completed INT NOT NULL DEFAULT 0,
  verified_by_admin BIGINT NULL,
  verified_at DATETIME NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT fk_expert_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  CONSTRAINT fk_expert_verified_by FOREIGN KEY (verified_by_admin) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 10) Reviews
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS reviews (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  reviewer_id BIGINT NOT NULL,
  expert_id BIGINT NOT NULL,
  project_id BIGINT NULL,
  rating TINYINT NOT NULL CHECK (rating BETWEEN 1 AND 5),
  title VARCHAR(140) NULL,
  content TEXT NULL,
  is_verified TINYINT(1) NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  UNIQUE KEY uq_review_reviewer_expert (reviewer_id, expert_id),
  INDEX idx_reviews_expert (expert_id),
  CONSTRAINT fk_reviews_reviewer FOREIGN KEY (reviewer_id) REFERENCES users(id) ON DELETE CASCADE,
  CONSTRAINT fk_reviews_expert FOREIGN KEY (expert_id) REFERENCES expert_profiles(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 11) Projects
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS projects (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  owner_id BIGINT NOT NULL,
  status ENUM('DRAFT','ACTIVE','ON_HOLD','COMPLETED','ARCHIVED') NOT NULL DEFAULT 'DRAFT',
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  region VARCHAR(80) NULL,
  land_size_sqm DECIMAL(12,2) NULL,
  building_type VARCHAR(80) NULL,
  budget_currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  budget_amount DECIMAL(14,2) NULL,
  spent_amount DECIMAL(14,2) NOT NULL DEFAULT 0,
  start_date DATE NULL,
  target_end_date DATE NULL,
  actual_end_date DATE NULL,
  progress_percent TINYINT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_projects_owner (owner_id),
  INDEX idx_projects_status (status),
  CONSTRAINT fk_projects_owner FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS project_members (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  project_id BIGINT NOT NULL,
  user_id BIGINT NOT NULL,
  member_role ENUM('OWNER','ENGINEER','CONTRACTOR','SUPPLIER','VIEWER') NOT NULL DEFAULT 'VIEWER',
  joined_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY uq_project_member (project_id, user_id),
  INDEX idx_project_members_project (project_id),
  CONSTRAINT fk_project_members_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE,
  CONSTRAINT fk_project_members_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 12) Progress Milestones
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS project_milestones (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  project_id BIGINT NOT NULL,
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  phase ENUM('PLANNING','FOUNDATION','STRUCTURE','ROOFING','FINISHING','HANDOVER') NOT NULL DEFAULT 'PLANNING',
  status ENUM('PENDING','IN_PROGRESS','COMPLETED') NOT NULL DEFAULT 'PENDING',
  planned_date DATE NULL,
  completed_date DATE NULL,
  cost_estimate DECIMAL(14,2) NULL,
  cost_actual DECIMAL(14,2) NULL,
  sort_order INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_milestones_project (project_id),
  CONSTRAINT fk_milestones_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 13) Uploads
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS uploads (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  uploaded_by BIGINT NOT NULL,
  entity_type ENUM('LISTING','PLAN','PROJECT','PROFILE','DOCUMENT','OTHER') NOT NULL DEFAULT 'OTHER',
  entity_id BIGINT NULL,
  file_type ENUM('IMAGE','PDF','DOC','DWG','OTHER') NOT NULL DEFAULT 'OTHER',
  mime_type VARCHAR(120) NULL,
  original_name VARCHAR(255) NULL,
  filename VARCHAR(255) NOT NULL,
  url VARCHAR(600) NOT NULL,
  size_bytes BIGINT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_uploads_uploader (uploaded_by),
  INDEX idx_uploads_entity (entity_type, entity_id),
  CONSTRAINT fk_uploads_user FOREIGN KEY (uploaded_by) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 14) Estimation + BOQ
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS estimates (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  created_by BIGINT NOT NULL,
  project_id BIGINT NULL,
  plan_id BIGINT NULL,
  title VARCHAR(140) NOT NULL,
  region_id INT NULL,
  building_type VARCHAR(80) NULL,
  area_sqm DECIMAL(12,2) NULL,
  floors INT NULL DEFAULT 1,
  currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  subtotal DECIMAL(14,2) NOT NULL DEFAULT 0,
  contingency_pct DECIMAL(5,2) NOT NULL DEFAULT 10,
  contingency DECIMAL(14,2) NOT NULL DEFAULT 0,
  taxes DECIMAL(14,2) NOT NULL DEFAULT 0,
  total DECIMAL(14,2) NOT NULL DEFAULT 0,
  notes TEXT NULL,
  ai_recommendations TEXT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_estimates_user (created_by),
  INDEX idx_estimates_project (project_id),
  CONSTRAINT fk_estimates_user FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE CASCADE,
  CONSTRAINT fk_estimates_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE SET NULL,
  CONSTRAINT fk_estimates_plan FOREIGN KEY (plan_id) REFERENCES plans(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS boq_items (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  estimate_id BIGINT NOT NULL,
  section VARCHAR(120) NULL,
  item_code VARCHAR(60) NULL,
  description VARCHAR(255) NOT NULL,
  unit VARCHAR(20) NULL,
  quantity DECIMAL(14,3) NOT NULL DEFAULT 0,
  unit_rate DECIMAL(14,2) NOT NULL DEFAULT 0,
  amount DECIMAL(14,2) NOT NULL DEFAULT 0,
  catalog_item_id BIGINT NULL,
  sort_order INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_boq_estimate (estimate_id),
  CONSTRAINT fk_boq_estimate FOREIGN KEY (estimate_id) REFERENCES estimates(id) ON DELETE CASCADE,
  CONSTRAINT fk_boq_catalog FOREIGN KEY (catalog_item_id) REFERENCES catalog_items(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 15) Permits
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS permit_guides (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  title VARCHAR(140) NOT NULL,
  category ENUM('BUILDING','ENVIRONMENTAL','UTILITIES','OCCUPANCY','OTHER') NOT NULL DEFAULT 'BUILDING',
  region VARCHAR(80) NULL,
  description TEXT NOT NULL,
  requirements TEXT NULL,
  estimated_cost_rwf DECIMAL(14,2) NULL,
  estimated_days INT NULL,
  issuing_authority VARCHAR(140) NULL,
  steps JSON NULL,
  is_active TINYINT(1) NOT NULL DEFAULT 1,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_permits_category (category)
) ENGINE=InnoDB;

