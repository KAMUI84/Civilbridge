// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Core Roles (as specified)
enum Role {
  SUPER_ADMIN          // 🧑‍💼 Super Admin (Owner)
  ADMIN               // 🛠 Admin (Manager)
  PROFESSIONAL        // 👷‍♂️ Professional / Engineer
  CLIENT              // 🧑‍💻 Client / Customer
  VIEWER              // 👁 Viewer / Guest
  AUDITOR             // 🧾 Auditor / Inspector
  FINANCE             // 💰 Finance Role
}

// Individual Permissions (RBAC)
enum Permission {
  // User Management
  MANAGE_USERS        // Create, edit, delete users
  ASSIGN_ROLES        // Assign roles to users
  
  // Project Management
  CREATE_PROJECT      // Create new projects
  EDIT_OWN_PROJECT    // Edit own projects
  EDIT_ANY_PROJECT    // Edit any project
  DELETE_OWN_PROJECT  // Delete own projects
  DELETE_ANY_PROJECT  // Delete any project
  VIEW_OWN_PROJECT    // View own projects
  VIEW_ANY_PROJECT    // View any project
  
  // Content Management
  APPROVE_REQUESTS    // Approve/reject submissions
  MODERATE_CONTENT    // Moderate user content
  
  // Analytics & Reports
  VIEW_ANALYTICS      // Access analytics dashboard
  VIEW_REPORTS        // Access reports
  GENERATE_REPORTS    // Generate financial reports
  
  // System Management
  SYSTEM_SETTINGS     // Configure system settings
  MANAGE_API_KEYS     // Manage API keys
  VIEW_LOGS           // View system logs
  
  // Financial
  MANAGE_TRANSACTIONS // Manage transactions
  VIEW_PAYMENT_HISTORY // View payment history
  
  // Communication
  COMMUNICATE_CLIENTS // Communicate with clients
  UPLOAD_FILES        // Upload files/documents
  
  // Basic Operations
  BROWSE_PUBLIC       // Browse public content
  LOGIN_ACCESS        // Login access
}

// Verification Status
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// User Model
model User {
  id                  Int                   @id @default(autoincrement())
  fullName            String                @map("full_name")
  email               String?               @unique
  phone               String?               @unique
  passwordHash        String?               @map("password_hash")
  googleSub           String?               @unique @map("google_sub")
  role                Role                  @default(CLIENT)
  verificationStatus  VerificationStatus    @default(UNVERIFIED) @map("verification_status")
  isActive            Boolean               @default(true) @map("is_active")
  lastLoginAt         DateTime?             @map("last_login_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  // Relationships
  auditLogs           AuditLog[]
  projectMemberships  ProjectMember[]
  createdProjects     Project[]             @relation("ProjectCreator")
  transactions        Transaction[]

  @@map("users")
}

// Role-Permission Mapping
model RolePermission {
  id          Int         @id @default(autoincrement())
  role        Role
  permission  Permission
  
  createdAt   DateTime    @default(now()) @map("created_at")
  
  @@unique([role, permission])
  @@map("role_permissions")
}

// Project Model (for context)
model Project {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  status      String      @default("draft")
  creatorId   Int         @map("creator_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  // Relationships
  creator     User        @relation("ProjectCreator", fields: [creatorId], references: [id])
  members     ProjectMember[]
  
  @@map("projects")
}

// Project Members (many-to-many with roles)
model ProjectMember {
  id         Int         @id @default(autoincrement())
  projectId  Int         @map("project_id")
  userId     Int         @map("user_id")
  role       String      @default("member") // member, lead, viewer
  
  project    Project     @relation(fields: [projectId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  
  createdAt  DateTime    @default(now()) @map("created_at")
  
  @@unique([projectId, userId])
  @@map("project_members")
}

// Transaction Model (for Finance role)
model Transaction {
  id          Int         @id @default(autoincrement())
  amount      Decimal
  currency    String      @default("RWF")
  type        String      // payment, refund, etc.
  status      String      @default("pending")
  userId      Int         @map("user_id")
  metadata    Json?       // Additional transaction data
  
  user        User        @relation(fields: [userId], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@map("transactions")
}

model OTPCode {
  id         Int      @id @default(autoincrement())
  target     String
  otpHash    String   @map("otp_hash")
  purpose    String   @default("register")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([target])
  @@index([expiresAt])
  @@map("otp_codes")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    Int?     @map("entity_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metaJson    String?  @map("meta_json")
  metadata    Json?    // For detailed audit information
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationship
  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
