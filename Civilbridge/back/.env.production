# ─────────────────────────────────────────────────────────────────────────────
# CivilBridge API — PRODUCTION environment template
#
# Copy this file to .env on your production server and fill in every value.
# NEVER commit a populated .env file to version control.
# Use a secret manager (HashiCorp Vault, AWS Secrets Manager, etc.) where
# possible — inject these as OS environment variables instead of a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info                          # debug | info | warn | error

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=<your-db-host>
DB_USER=<your-db-user>
DB_PASSWORD=<ROTATE-this-immediately>
DB_NAME=civilbridge

DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>?connection_limit=10&pool_timeout=20&connect_timeout=10&ssl=true"
DIRECT_DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>?ssl=true"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<minimum-64-char-random-string>

# ── CORS — production frontend domain(s) ─────────────────────────────────────
# Comma-separated list. Only these origins are allowed in production.
ALLOWED_ORIGINS=https://civilbridge.rw,https://www.civilbridge.rw
FRONTEND_URL=https://civilbridge.rw

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=<your-gmail-address>
EMAIL_PASS=<your-gmail-app-password>    # Use an App Password, not your login password

# ── Payments — MTN MoMo ──────────────────────────────────────────────────────
MTN_MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_COLLECTION_PATH=/collection/v1_0
MTN_MOMO_API_USER=<your-api-user-uuid>
MTN_MOMO_API_KEY=<your-api-key>
MTN_MOMO_SUBSCRIPTION_KEY=<your-subscription-key>
MTN_MOMO_TARGET_ENVIRONMENT=production
MTN_MOMO_CALLBACK_URL=https://api.civilbridge.rw/api/v1/payments/webhook/mtn
MTN_MOMO_WEBHOOK_SECRET=<signing-secret>
MTN_MOMO_WEBHOOK_SIGNATURE_HEADER=x-signature
MTN_MOMO_REFUND_PATH=/collection/v1_0/refund

# ── Payments — Airtel Money Rwanda ───────────────────────────────────────────
AIRTEL_RW_BASE_URL=https://openapi.airtel.africa
AIRTEL_RW_AUTH_PATH=/auth/oauth2/token
AIRTEL_RW_COLLECT_PATH=/merchant/v1/payments/
AIRTEL_RW_STATUS_PATH=/standard/v1/payments/{reference}
AIRTEL_RW_REFUND_PATH=/standard/v1/payments/{reference}/refund
AIRTEL_RW_CLIENT_ID=<your-client-id>
AIRTEL_RW_CLIENT_SECRET=<your-client-secret>
AIRTEL_RW_COUNTRY=RW
AIRTEL_RW_CURRENCY=RWF
AIRTEL_RW_CALLBACK_URL=https://api.civilbridge.rw/api/v1/payments/webhook/airtel
AIRTEL_RW_WEBHOOK_SECRET=<signing-secret>
AIRTEL_RW_WEBHOOK_SIGNATURE_HEADER=x-signature

# ── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_<your-live-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>
STRIPE_API_BASE_URL=https://api.stripe.com/v1

# ── AI — Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STRUCTURED_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── AI — Routing ──────────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=gemini
AI_ANALYZE_PLAN_PDF_PROVIDER=claude
AI_ANALYZE_PLAN_IMAGE_PROVIDER=gemini
AI_GENERATE_PLAN_PROVIDER=gemini
AI_ESTIMATE_PROVIDER=gemini
AI_BUDGET_ANALYSIS_PROVIDER=gemini
AI_FEASIBILITY_PROVIDER=gemini

# ── AI — Claude / Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-key>
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01
