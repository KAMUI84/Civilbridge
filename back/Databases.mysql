-- ---------------------------------------------------------
-- 5) Catalog (Materials & Labor Pricing)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS catalog_items (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(140) NOT NULL,
  category ENUM('materials','labor','equipment','other') NOT NULL DEFAULT 'materials',
  unit VARCHAR(30) NOT NULL DEFAULT 'unit',
  base_price_rwf DECIMAL(14,2) NOT NULL DEFAULT 0,
  specifications JSON NULL,
  supplier_name VARCHAR(140) NULL,
  is_active TINYINT(1) NOT NULL DEFAULT 1,
  last_updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_catalog_category (category),
  INDEX idx_catalog_active (is_active)
) ENGINE=InnoDB;

