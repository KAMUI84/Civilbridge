# Development Environment Configuration
NODE_ENV=development
PORT=3000

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET="development-jwt-secret-key-min-32-chars"
JWT_REFRESH_SECRET="development-refresh-secret-key-min-32-chars"

# Google OAuth (optional for development)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# X (Twitter) OAuth 2.0 (optional for development)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_BEARER_TOKEN=""
X_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# Facebook OAuth (optional for development)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# Email Configuration (Gmail)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="CivilBridge <noreply@civilbridge.rw>"

# CORS
CORS_ORIGIN="http://localhost:5173"
CORS_CREDENTIALS=true

# CSRF
CSRF_SECRET="development-csrf-secret-key-min-32-chars"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# AI Service (optional)
GEMINI_API_KEY=""
AI_RATE_LIMIT_PER_MINUTE=10
AI_GUEST_MESSAGE_LIMIT=3

# Platform commission deducted before paying out to professionals (default 15%)
PLATFORM_FEE_PERCENT=15
