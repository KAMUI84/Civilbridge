model Transaction {
  id                    BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  userId                BigInt             @map("user_id") @db.UnsignedBigInt
  recipientId           BigInt?            @map("recipient_id") @db.UnsignedBigInt
  provider              PaymentProvider    @default(MANUAL)
  reference             String?            @unique @db.VarChar(120)
  invoiceNumber         String?            @unique @map("invoice_number") @db.VarChar(80)
  amount                Decimal            @db.Decimal(16, 2)
  currency              String             @default("RWF") @db.VarChar(20)
  type                  String             @db.VarChar(50)
  serviceType           PaymentServiceType @default(OTHER) @map("service_type")
  serviceReference      String?            @map("service_reference") @db.VarChar(120)
  serviceLabel          String?            @map("service_label") @db.VarChar(160)
  description           String?            @db.VarChar(255)
  phoneNumber           String?            @map("phone_number") @db.VarChar(30)
  providerTransactionId String?            @map("provider_transaction_id") @db.VarChar(191)
  redirectUrl           String?            @map("redirect_url") @db.VarChar(500)
  ussdPrompt            String?            @map("ussd_prompt") @db.VarChar(255)
  status                PaymentStatus      @default(INITIATED)
  providerStatus        String?            @map("provider_status") @db.VarChar(60)
  webhookStatus         String?            @map("webhook_status") @db.VarChar(40)
  escrowStatus          EscrowStatus       @default(NONE) @map("escrow_status")
  metadata              Json?
  heldAt                DateTime?          @map("held_at")
  settledAt             DateTime?          @map("settled_at")
  receiptIssuedAt       DateTime?          @map("receipt_issued_at")
  releaseRequestedAt    DateTime?          @map("release_requested_at")
  releasedAt            DateTime?          @map("released_at")
  milestoneStage        ProjectStage?      @map("milestone_stage")
  milestoneApprovedAt   DateTime?          @map("milestone_approved_at")
  refundReference       String?            @map("refund_reference") @db.VarChar(120)
  refundReason          String?            @map("refund_reason") @db.VarChar(255)
  refundRequestedAt     DateTime?          @map("refund_requested_at")
  refundedAt            DateTime?          @map("refunded_at")
  failureReason         String?            @map("failure_reason") @db.VarChar(255)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient     User?                 @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  webhookEvents PaymentWebhookEvent[]
  payout        Payout?

  @@index([userId])
  @@index([recipientId])
  @@index([provider])
  @@index([status])
  @@index([serviceType])
  @@index([serviceReference])
  @@index([escrowStatus])
  @@index([createdAt])
  @@map("transactions")
}

model PaymentWebhookEvent {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  transactionId   BigInt?         @map("transaction_id") @db.UnsignedBigInt
  provider        PaymentProvider
  eventType       String          @map("event_type") @db.VarChar(120)
  externalEventId String?         @map("external_event_id") @db.VarChar(191)
  signatureValid  Boolean         @default(false) @map("signature_valid")
  payload         Json
  receivedAt      DateTime        @default(now()) @map("received_at")
  processedAt     DateTime?       @map("processed_at")
  processingError String?         @map("processing_error") @db.VarChar(255)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([provider])
  @@index([receivedAt])
  @@map("payment_webhook_events")
}

model Payout {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  transactionId BigInt       @unique @map("transaction_id") @db.UnsignedBigInt
  recipientId   BigInt       @map("recipient_id") @db.UnsignedBigInt
  grossAmount   Decimal      @map("gross_amount") @db.Decimal(16, 2)
  platformFee   Decimal      @map("platform_fee") @db.Decimal(16, 2)
  feePercent    Decimal      @map("fee_percent") @db.Decimal(5, 2)
  netAmount     Decimal      @map("net_amount") @db.Decimal(16, 2)
  currency      String       @default("RWF") @db.VarChar(20)
  status        PayoutStatus @default(PENDING)
  notes         String?      @db.VarChar(255)
  settledAt     DateTime?    @map("settled_at")
  settledById   BigInt?      @map("settled_by_id") @db.UnsignedBigInt
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recipient   User        @relation("PayoutRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  settledBy   User?       @relation("PayoutSettler", fields: [settledById], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@map("payouts")
}

