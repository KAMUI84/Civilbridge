generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  HOME_BUILDER
  STUDENT
  ENGINEER
  CONTRACTOR
  SUPPLIER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingType {
  PROPERTY
  LAND
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  INACTIVE
  ARCHIVED
}

enum PlanCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRA
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum ProviderType {
  CONTRACTOR
  SUPPLIER
  ENGINEER
  ARCHITECT
}

enum ProviderVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRA
}

enum FinishLevel {
  BASIC
  STANDARD
  PREMIUM
}

enum StructureType {
  RC_FRAME
  MASONRY
  STEEL_FRAME
}

enum RoofType {
  IRON_SHEETS
  TILES
  CONCRETE
  OTHER
}

enum ProjectStatus {
  DRAFT
  ESTIMATED
  DOCUMENTS
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum BOQCategory {
  FOUNDATION
  STRUCTURE
  ROOFING
  FINISHES
  PLUMBING
  ELECTRICAL
  LABOR
  OTHER
}

enum DocumentType {
  PLAN_UPLOAD
  BOQ_PDF
  BOQ_EXCEL
  FEASIBILITY_PDF
  ESTIMATE_PDF
  CARBON_PDF
  ROI_PDF
  PERMIT_FILE
  IMAGE
  OTHER
}

enum PermitProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRA
}

enum PlanRequestType {
  CUSTOMIZE
  BUY_FULL_PACKAGE
  ASK_EXPERT
}

enum PlanRequestStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  REJECTED
  COMPLETED
}

enum LeadRequestType {
  MORE_INFO
  SCHEDULE_VISIT
  CONNECT_AGENT
}

enum LeadRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

enum UploadEntityType {
  LISTING
  PLAN
  PROJECT
  PROFILE
  OTHER
}

enum UploadFileType {
  IMAGE
  PDF
  DOC
  OTHER
}

enum OTPPurpose {
  register
  login
  reset_password
  verify_contact
}

enum ProjectStage {
  FOUNDATION
  STRUCTURE
  ROOFING
  FINISHES
  PLUMBING
  ELECTRICAL
  OTHER
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RegionMultiplierScope {
  MATERIAL
  LABOR
  TRANSPORT
  OVERALL
}

model User {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  fullName            String               @map("full_name") @db.VarChar(120)
  email               String?              @unique @db.VarChar(190)
  phone               String?              @unique @db.VarChar(40)
  passwordHash        String?              @map("password_hash") @db.VarChar(255)
  googleSub           String?              @unique @map("google_sub") @db.VarChar(64)
  role                UserRole             @default(USER)
  regionId            BigInt?              @map("region_id") @db.UnsignedBigInt
  verificationStatus  VerificationStatus   @default(UNVERIFIED) @map("verification_status")
  isActive            Boolean              @default(true) @map("is_active")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  region              Region?              @relation(fields: [regionId], references: [id])
  profile             UserProfile?
  sessions            UserSession[]
  ownedListings       Listing[]            @relation("ListingOwner")
  createdPlans        Plan[]               @relation("PlanCreator")
  providerProfile     ServiceProvider?
  providerReviews     ProviderReview[]
  projects            Project[]
  projectMemberships  ProjectMember[]
  documents           ProjectDocument[]
  uploads             Upload[]
  aiConversations     AIConversation[]
  auditLogs           AuditLog[]
  leadRequests        LeadRequest[]
  planRequests        PlanRequest[]

  @@index([role])
  @@index([regionId])
  @@map("users")
}

model UserProfile {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt    @unique @map("user_id") @db.UnsignedBigInt
  profession   String?   @db.VarChar(120)
  companyName  String?   @map("company_name") @db.VarChar(160)
  addressText  String?   @map("address_text") @db.VarChar(255)
  bio          String?   @db.Text
  avatarUrl    String?   @map("avatar_url") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  deviceInfo  String?   @map("device_info") @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OTPCode {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  target     String     @db.VarChar(255)
  otpHash    String     @map("otp_hash") @db.VarChar(255)
  purpose    OTPPurpose @default(register)
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([target])
  @@index([expiresAt])
  @@index([target, purpose])
  @@map("otp_codes")
}

model Region {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name               String              @unique @db.VarChar(120)
  country            String              @default("Rwanda") @db.VarChar(120)
  currency           String              @default("RWF") @db.VarChar(20)
  createdAt          DateTime            @default(now()) @map("created_at")

  users              User[]
  listings           Listing[]
  serviceProviders   ServiceProvider[]
  projects           Project[]
  permitRequirements PermitRequirement[]
  multipliers        RegionMultiplier[]

  @@map("regions")
}

model RegionMultiplier {
  id          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  regionId    BigInt                  @map("region_id") @db.UnsignedBigInt
  scope       RegionMultiplierScope
  multiplier  Decimal                 @default(1.0000) @db.Decimal(10, 4)
  activeFrom  DateTime                @map("active_from") @db.Date
  activeTo    DateTime?               @map("active_to") @db.Date
  createdAt   DateTime                @default(now()) @map("created_at")

  region      Region                  @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId])
  @@map("region_multipliers")
}

model CostCatalogItem {
  id                     BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  code                   String             @unique @db.VarChar(60)
  name                   String             @db.VarChar(190)
  category               BOQCategory
  unit                   String             @db.VarChar(40)
  baseUnitCost           Decimal            @map("base_unit_cost") @db.Decimal(14, 2)
  defaultWastagePercent  Decimal            @default(0) @map("default_wastage_percent") @db.Decimal(6, 2)
  isActive               Boolean            @default(true) @map("is_active")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  boqItems               ProjectBOQItem[]
  emissionFactor         EmissionFactor?

  @@index([category])
  @@map("cost_catalog_items")
}

model Listing {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  listingType   ListingType    @map("listing_type")
  title         String         @db.VarChar(190)
  description   String?        @db.Text
  regionId      BigInt         @map("region_id") @db.UnsignedBigInt
  locationText  String?        @map("location_text") @db.VarChar(190)
  price         Decimal?       @db.Decimal(16, 2)
  currency      String         @default("RWF") @db.VarChar(20)
  sizeM2        Decimal?       @map("size_m2") @db.Decimal(12, 2)
  bedrooms      Int?
  bathrooms     Int?
  zoningInfo    String?        @map("zoning_info") @db.VarChar(190)
  status        ListingStatus  @default(ACTIVE)
  ownerUserId   BigInt?        @map("owner_user_id") @db.UnsignedBigInt
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  region        Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  owner         User?          @relation("ListingOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  images        ListingImage[]
  leadRequests  LeadRequest[]

  @@index([listingType])
  @@index([regionId])
  @@map("listings")
}

model ListingImage {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  listingId  BigInt    @map("listing_id") @db.UnsignedBigInt
  imageUrl   String    @map("image_url") @db.VarChar(255)
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")

  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model LeadRequest {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  listingId        BigInt             @map("listing_id") @db.UnsignedBigInt
  requesterUserId  BigInt?            @map("requester_user_id") @db.UnsignedBigInt
  name             String?            @db.VarChar(120)
  phone            String?            @db.VarChar(40)
  email            String?            @db.VarChar(190)
  message          String?            @db.Text
  requestType      LeadRequestType    @map("request_type")
  status           LeadRequestStatus  @default(NEW)
  createdAt        DateTime           @default(now()) @map("created_at")

  listing          Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester        User?              @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("lead_requests")
}

model Plan {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  category          PlanCategory
  title             String        @db.VarChar(190)
  style             String?       @db.VarChar(120)
  description       String?       @db.Text
  builtAreaM2       Decimal       @map("built_area_m2") @db.Decimal(12, 2)
  floors            Int           @default(1)
  bedrooms          Int?
  isVerified        Boolean       @default(false) @map("is_verified")
  tier              PlanTier      @default(FREE)
  estimatedCostMin  Decimal?      @map("estimated_cost_min") @db.Decimal(16, 2)
  estimatedCostMax  Decimal?      @map("estimated_cost_max") @db.Decimal(16, 2)
  createdByUserId   BigInt?       @map("created_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime      @default(now()) @map("created_at")

  creator           User?         @relation("PlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assets            PlanAsset[]
  requests          PlanRequest[]
  estimateSummaries EstimateSummary[]

  @@index([category])
  @@map("plans")
}

model PlanAsset {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  planId      BigInt      @map("plan_id") @db.UnsignedBigInt
  assetType   String      @map("asset_type") @db.VarChar(40)
  fileUrl     String      @map("file_url") @db.VarChar(255)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_assets")
}

model PlanRequest {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  planId           BigInt             @map("plan_id") @db.UnsignedBigInt
  requesterUserId  BigInt             @map("requester_user_id") @db.UnsignedBigInt
  requestType      PlanRequestType    @map("request_type")
  notes            String?            @db.Text
  status           PlanRequestStatus  @default(NEW)
  createdAt        DateTime           @default(now()) @map("created_at")

  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  requester        User               @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_requests")
}

model ServiceProvider {
  id                   BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  userId               BigInt                       @unique @map("user_id") @db.UnsignedBigInt
  providerType         ProviderType                 @map("provider_type")
  businessName         String                       @map("business_name") @db.VarChar(160)
  specialtiesJson      Json?                        @map("specialties_json")
  regionId             BigInt?                      @map("region_id") @db.UnsignedBigInt
  verificationStatus   ProviderVerificationStatus   @default(PENDING) @map("verification_status")
  avgRating            Decimal                      @default(0) @map("avg_rating") @db.Decimal(4, 2)
  createdAt            DateTime                     @default(now()) @map("created_at")

  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  region               Region?                      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  reviews              ProviderReview[]

  @@index([providerType])
  @@map("service_providers")
}

model ProviderReview {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  providerId       BigInt    @map("provider_id") @db.UnsignedBigInt
  reviewerUserId   BigInt    @map("reviewer_user_id") @db.UnsignedBigInt
  rating           Int
  comment          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  provider         ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewer         User            @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_reviews")
}

model Project {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt         @map("user_id") @db.UnsignedBigInt
  projectName      String         @map("project_name") @db.VarChar(160)
  projectType      ProjectType    @default(RESIDENTIAL) @map("project_type")
  regionId         BigInt         @map("region_id") @db.UnsignedBigInt
  plotSizeM2       Decimal?       @map("plot_size_m2") @db.Decimal(10, 2)
  builtAreaM2      Decimal        @map("built_area_m2") @db.Decimal(10, 2)
  floors           Int            @default(1)
  bedrooms         Int?
  finishLevel      FinishLevel    @default(STANDARD) @map("finish_level")
  structureType    StructureType  @default(RC_FRAME) @map("structure_type")
  roofType         RoofType       @default(IRON_SHEETS) @map("roof_type")
  status           ProjectStatus  @default(DRAFT)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  region           Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  estimateSummary  EstimateSummary?
  boqItems         ProjectBOQItem[]
  documents        ProjectDocument[]
  progressLogs     ProjectProgressLog[]
  roiReport        ProjectROIReport?
  carbonSummary    ProjectCarbonSummary?
  members          ProjectMember[]

  @@index([userId])
  @@index([regionId])
  @@map("projects")
}

model ProjectMember {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId    BigInt   @map("project_id") @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  memberRole   String   @map("member_role") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

model EstimateSummary {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId             BigInt    @unique @map("project_id") @db.UnsignedBigInt
  planId                BigInt?   @map("plan_id") @db.UnsignedBigInt
  estimatedTotalCost    Decimal   @map("estimated_total_cost") @db.Decimal(16, 2)
  costPerM2             Decimal   @map("cost_per_m2") @db.Decimal(16, 2)
  riskBufferPercent     Decimal   @default(10.00) @map("risk_buffer_percent") @db.Decimal(6, 2)
  riskBufferAmount      Decimal   @map("risk_buffer_amount") @db.Decimal(16, 2)
  finalEstimatedCost    Decimal   @map("final_estimated_cost") @db.Decimal(16, 2)
  assumptionsJson       Json?     @map("assumptions_json")
  createdAt             DateTime  @default(now()) @map("created_at")

  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan                  Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@map("estimate_summaries")
}

model ProjectBOQItem {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  projectId       BigInt      @map("project_id") @db.UnsignedBigInt
  catalogItemId   BigInt?     @map("catalog_item_id") @db.UnsignedBigInt
  customName      String?     @map("custom_name") @db.VarChar(190)
  category        BOQCategory
  unit            String      @db.VarChar(40)
  quantity        Decimal     @db.Decimal(14, 3)
  unitCost        Decimal     @map("unit_cost") @db.Decimal(14, 2)
  totalCost       Decimal     @map("total_cost") @db.Decimal(16, 2)
  notes           String?     @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at")

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogItem     CostCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_boq_items")
}

model ProjectDocument {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  projectId        BigInt      @map("project_id") @db.UnsignedBigInt
  userId           BigInt?     @map("user_id") @db.UnsignedBigInt
  docType          DocumentType @map("doc_type")
  fileUrl          String      @map("file_url") @db.VarChar(255)
  originalName     String?     @map("original_name") @db.VarChar(190)
  mimeType         String?     @map("mime_type") @db.VarChar(120)
  fileSizeBytes    BigInt?     @map("file_size_bytes") @db.UnsignedBigInt
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @map("created_at")

  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_documents")
}

model ProjectProgressLog {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  projectId         BigInt      @map("project_id") @db.UnsignedBigInt
  logDate           DateTime    @map("log_date") @db.Date
  stage             ProjectStage
  progressPercent   Decimal     @map("progress_percent") @db.Decimal(6, 2)
  amountSpent       Decimal     @default(0) @map("amount_spent") @db.Decimal(16, 2)
  notes             String?     @db.VarChar(255)
  createdAt         DateTime    @default(now()) @map("created_at")

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_progress_logs")
}

model PermitRequirement {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  regionId         BigInt             @map("region_id") @db.UnsignedBigInt
  projectType      PermitProjectType  @map("project_type")
  permitName       String             @map("permit_name") @db.VarChar(190)
  authorityName    String?            @map("authority_name") @db.VarChar(190)
  estimatedFee     Decimal?           @map("estimated_fee") @db.Decimal(16, 2)
  estimatedDays    Int?               @map("estimated_days")
  stepsJson        Json?              @map("steps_json")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")

  region           Region             @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId])
  @@map("permit_requirements")
}

model ProjectROIReport {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId             BigInt    @unique @map("project_id") @db.UnsignedBigInt
  expectedRentPerMonth  Decimal?  @map("expected_rent_per_month") @db.Decimal(16, 2)
  expectedSalePrice     Decimal?  @map("expected_sale_price") @db.Decimal(16, 2)
  maintenancePerYear    Decimal?  @map("maintenance_per_year") @db.Decimal(16, 2)
  vacancyRatePercent    Decimal   @default(0) @map("vacancy_rate_percent") @db.Decimal(6, 2)
  roiPercent            Decimal   @map("roi_percent") @db.Decimal(8, 3)
  paybackYears          Decimal   @map("payback_years") @db.Decimal(8, 3)
  breakEvenMonths       Int       @map("break_even_months")
  createdAt             DateTime  @default(now()) @map("created_at")

  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_roi_reports")
}

model EmissionFactor {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  catalogItemId   BigInt   @unique @map("catalog_item_id") @db.UnsignedBigInt
  co2PerUnit      Decimal  @map("co2_per_unit") @db.Decimal(14, 6)
  unit            String   @db.VarChar(40)
  sourceNote      String?  @map("source_note") @db.VarChar(255)
  activeFrom      DateTime @map("active_from") @db.Date
  activeTo        DateTime? @map("active_to") @db.Date

  catalogItem     CostCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@map("emission_factors")
}

model ProjectCarbonSummary {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId             BigInt    @unique @map("project_id") @db.UnsignedBigInt
  totalCo2Kg            Decimal   @map("total_co2_kg") @db.Decimal(16, 3)
  co2PerM2              Decimal   @map("co2_per_m2") @db.Decimal(16, 3)
  transportDistanceKm   Decimal?  @map("transport_distance_km") @db.Decimal(10, 2)
  notesJson             Json?     @map("notes_json")
  createdAt             DateTime  @default(now()) @map("created_at")

  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_carbon_summaries")
}

model AIConversation {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt?      @map("user_id") @db.UnsignedBigInt
  guestId     String?      @map("guest_id") @db.VarChar(80)
  title       String?      @db.VarChar(190)
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId])
  @@index([guestId])
  @@map("ai_conversations")
}

model AIMessage {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId    BigInt        @map("conversation_id") @db.UnsignedBigInt
  role              AIMessageRole
  content           String        @db.Text
  metaJson          Json?         @map("meta_json")
  createdAt         DateTime      @default(now()) @map("created_at")

  conversation      AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model GuestChatLimit {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  guestId       String    @unique @map("guest_id") @db.VarChar(80)
  messageCount  Int       @default(0) @map("message_count")
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @updatedAt @map("last_seen_at")

  @@map("guest_chat_limits")
}

model Upload {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uploadedById   BigInt          @map("uploaded_by_id") @db.UnsignedBigInt
  entityType     UploadEntityType @map("entity_type")
  entityId       BigInt?         @map("entity_id") @db.UnsignedBigInt
  fileType       UploadFileType  @map("file_type")
  mimeType       String?         @map("mime_type") @db.VarChar(120)
  filename       String          @db.VarChar(255)
  url            String          @db.VarChar(600)
  sizeBytes      BigInt?         @map("size_bytes") @db.UnsignedBigInt
  createdAt      DateTime        @default(now()) @map("created_at")

  uploadedBy     User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([entityType, entityId])
  @@map("uploads")
}

model AuditLog {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt?   @map("user_id") @db.UnsignedBigInt
  action      String    @db.VarChar(80)
  entityType  String?   @map("entity_type") @db.VarChar(60)
  entityId    BigInt?   @map("entity_id") @db.UnsignedBigInt
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  metaJson    Json?     @map("meta_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
datasource db {
  provider = "postgresql" // or "mysql" depending on what you use
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  role  String  @default("USER")
}