model Message {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId BigInt        @map("conversation_id") @db.UnsignedBigInt
  senderId       BigInt        @map("sender_id") @db.UnsignedBigInt
  recipientId    BigInt        @map("recipient_id") @db.UnsignedBigInt
  body           String        @db.Text
  attachmentUrl      String?   @map("attachment_url") @db.VarChar(600)
  attachmentName     String?   @map("attachment_name") @db.VarChar(255)
  attachmentMimeType String?   @map("attachment_mime_type") @db.VarChar(120)
  attachmentSizeBytes BigInt?  @map("attachment_size_bytes") @db.UnsignedBigInt
  status         MessageStatus @default(SENT)
  deliveredAt    DateTime?     @map("delivered_at")
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
