  recipient    User         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@map("messages")
}

// ─── Cost Benchmarks ──────────────────────────────────────────────────────────
// Admin-managed reference table: cost per sqm by Province/District + building type.
// Used by the estimator module and the analytics API.
// Apply with: prisma db push  (or prisma migrate dev --name add_cost_benchmarks)

model CostBenchmark {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  province     String   @db.VarChar(120)
  district     String   @default("") @db.VarChar(120)
  buildingType String   @map("building_type") @db.VarChar(60)
  minCostPerM2 Decimal  @map("min_cost_per_m2") @db.Decimal(16, 2)
  maxCostPerM2 Decimal  @map("max_cost_per_m2") @db.Decimal(16, 2)
  currency     String   @default("RWF") @db.VarChar(20)
  notes        String?  @db.VarChar(255)
  updatedById  BigInt?  @map("updated_by_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("CostBenchmarkUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([province, district, buildingType], name: "province_district_buildingType")
  @@index([province])
  @@index([updatedById])
  @@index([createdAt])
  @@map("cost_benchmarks")
}

