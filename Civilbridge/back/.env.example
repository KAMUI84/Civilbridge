# Core database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=civilbridge
DATABASE_URL="mysql://root:your_database_password@localhost:3306/civilbridge?connection_limit=10&pool_timeout=20&connect_timeout=10"
DIRECT_DATABASE_URL="mysql://root:your_database_password@localhost:3306/civilbridge"

# App runtime
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000
# Public frontend base URL used when email templates build links back into the app.
FRONTEND_URL=http://localhost:3000
# Logo URL embedded in outgoing emails. Falls back to FRONTEND_URL/logo.png if not set.
EMAIL_LOGO_URL=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
UPLOAD_MAX_SIZE=10mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
CLUSTER_MODE=false
CDN_URL=
SENTRY_DSN=

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# X (Twitter) OAuth 2.0
# Replace these with your X developer app credentials.
# Consumer Key = X_CLIENT_ID
# Secret Key = X_CLIENT_SECRET
# Bearer Token is only required for app-level API calls, not login.
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_BEARER_TOKEN=your_x_bearer_token
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# Facebook OAuth 2.0
# Replace these with your Facebook App credentials.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# AI - Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STRUCTURED_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# AI - Routing
AI_DEFAULT_PROVIDER=gemini
AI_ANALYZE_PLAN_PDF_PROVIDER=claude
AI_ANALYZE_PLAN_IMAGE_PROVIDER=gemini
AI_GENERATE_PLAN_PROVIDER=gemini
AI_ESTIMATE_PROVIDER=gemini
AI_BUDGET_ANALYSIS_PROVIDER=gemini
AI_FEASIBILITY_PROVIDER=gemini

# AI - Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01

# Email + queue
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=CivilBridge <noreply@civilbridge.rw>
EMAIL_QUEUE_NAME=civilbridge-email
REDIS_URL=
ENABLE_APPOINTMENT_REMINDER_SCHEDULER=true
APPOINTMENT_REMINDER_INTERVAL_MS=300000

# Cloudinary PDF storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PDF_FOLDER=civilbridge/pdfs

# Payments - MTN MoMo
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_COLLECTION_PATH="/collection/v1_0"
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_CALLBACK_URL="https://your-api.example.com/api/payments/webhook/mtn"
MTN_MOMO_WEBHOOK_SECRET=""
MTN_MOMO_WEBHOOK_SIGNATURE_HEADER="x-signature"
MTN_MOMO_PARTY_ID_TYPE="MSISDN"
MTN_MOMO_PAYER_MESSAGE="CivilBridge payment"
MTN_MOMO_REFUND_PATH="/collection/v1_0/refund"

# Payments - Airtel Money Rwanda
AIRTEL_RW_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_RW_AUTH_PATH="/auth/oauth2/token"
AIRTEL_RW_COLLECT_PATH="/merchant/v1/payments/"
AIRTEL_RW_STATUS_PATH="/standard/v1/payments/{reference}"
AIRTEL_RW_REFUND_PATH="/standard/v1/payments/{reference}/refund"
AIRTEL_RW_CLIENT_ID=""
AIRTEL_RW_CLIENT_SECRET=""
AIRTEL_RW_COUNTRY="RW"
AIRTEL_RW_CURRENCY="RWF"
AIRTEL_RW_CALLBACK_URL="https://your-api.example.com/api/payments/webhook/airtel"
AIRTEL_RW_WEBHOOK_SECRET=""
AIRTEL_RW_WEBHOOK_SIGNATURE_HEADER="x-signature"

# Payments - Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_API_BASE_URL="https://api.stripe.com/v1"

# Development note:
# Leave EMAIL_USER and EMAIL_PASS empty to use Ethereal test accounts.
