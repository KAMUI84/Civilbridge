-- =========================================================
-- CivilBridge (MVP) - Full MySQL Schema
-- =========================================================

CREATE DATABASE IF NOT EXISTS civilbridge
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE civilbridge;

-- ---------------------------------------------------------
-- 0) Housekeeping (optional in new DB)
-- ---------------------------------------------------------
SET FOREIGN_KEY_CHECKS = 0;
-- drop tables in reverse dependency order if you want reset:
-- DROP TABLE IF EXISTS ai_messages, ai_threads, boq_items, estimates, project_members,
--   projects, uploads, plan_images, plans, listing_images, listings,
--   expert_profiles, user_sessions, otp_codes, users, roles, audit_logs;
SET FOREIGN_KEY_CHECKS = 1;

-- ---------------------------------------------------------
-- 1) Roles & Users
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS roles (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(40) NOT NULL UNIQUE,           -- ADMIN, ENGINEER, CONTRACTOR, SUPPLIER, STUDENT, HOME_BUILDER, USER
  description VARCHAR(255) NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS users (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  full_name VARCHAR(120) NOT NULL,
  email VARCHAR(190) NULL UNIQUE,
  phone VARCHAR(40) NULL UNIQUE,
  password_hash VARCHAR(255) NULL,            -- null for google-only accounts
  google_sub VARCHAR(64) NULL UNIQUE,         -- Google subject ID (optional)
  role_id INT NOT NULL,
  region VARCHAR(80) NULL,
  profession VARCHAR(80) NULL,
  verification_status ENUM('UNVERIFIED','PENDING','VERIFIED') NOT NULL DEFAULT 'UNVERIFIED',
  is_active TINYINT(1) NOT NULL DEFAULT 1,
  last_login_at DATETIME NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT fk_users_role FOREIGN KEY (role_id) REFERENCES roles(id)
) ENGINE=InnoDB;

-- Seed roles (safe to run multiple times)
INSERT IGNORE INTO roles (name, description) VALUES
('ADMIN','Platform administrator'),
('ENGINEER','Verified engineer'),
('CONTRACTOR','Verified contractor'),
('SUPPLIER','Supplier/vendor'),
('STUDENT','Student user'),
('HOME_BUILDER','Home builder'),
('USER','Standard user');

-- ---------------------------------------------------------
-- 2) OTP & Sessions
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS otp_codes (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  target VARCHAR(255) NOT NULL,               -- email or phone
  otp_hash VARCHAR(255) NOT NULL,             -- sha256 hash
  purpose VARCHAR(30) NOT NULL DEFAULT 'register',
  expires_at DATETIME NOT NULL,
  attempts INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_otp_target (target),
  INDEX idx_otp_purpose (purpose),
  INDEX idx_otp_expires (expires_at)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS user_sessions (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT NOT NULL,
  token_hash VARCHAR(255) NOT NULL,           -- store hash of token if you use real tokens later
  device_info VARCHAR(255) NULL,
  ip_address VARCHAR(64) NULL,
  expires_at DATETIME NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_sessions_user (user_id),
  INDEX idx_sessions_expires (expires_at),
  CONSTRAINT fk_sessions_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 3) Marketplace Listings (Real Estate & Land)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS listings (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  created_by BIGINT NOT NULL,
  status ENUM('DRAFT','PUBLISHED','ARCHIVED') NOT NULL DEFAULT 'DRAFT',
  listing_type ENUM('LAND','PROPERTY') NOT NULL DEFAULT 'LAND',
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  region VARCHAR(80) NULL,
  district VARCHAR(80) NULL,
  sector VARCHAR(80) NULL,
  address_text VARCHAR(255) NULL,
  lat DECIMAL(10,7) NULL,
  lng DECIMAL(10,7) NULL,
  size_sqm DECIMAL(12,2) NULL,
  price_currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  price_amount DECIMAL(14,2) NULL,
  ownership_type VARCHAR(50) NULL,
  contact_phone VARCHAR(40) NULL,
  contact_email VARCHAR(190) NULL,
  view_count INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_listings_status (status),
  INDEX idx_listings_region (region),
  INDEX idx_listings_type (listing_type),
  CONSTRAINT fk_listings_user FOREIGN KEY (created_by) REFERENCES users(id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS listing_images (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  listing_id BIGINT NOT NULL,
  url VARCHAR(500) NOT NULL,
  alt_text VARCHAR(140) NULL,
  sort_order INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_listing_images_listing (listing_id),
  CONSTRAINT fk_listing_images_listing FOREIGN KEY (listing_id) REFERENCES listings(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 4) Plans Library (Architectural/Structural Plans)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS plans (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  created_by BIGINT NOT NULL,                 -- engineers/admins can publish
  status ENUM('DRAFT','PUBLISHED','ARCHIVED') NOT NULL DEFAULT 'DRAFT',
  category ENUM('RESIDENTIAL','COMMERCIAL','INDUSTRIAL') NOT NULL DEFAULT 'RESIDENTIAL',
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  bedrooms INT NULL,
  bathrooms INT NULL,
  floors INT NULL,
  area_sqm DECIMAL(12,2) NULL,
  estimated_cost_min DECIMAL(14,2) NULL,
  estimated_cost_max DECIMAL(14,2) NULL,
  currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  tags VARCHAR(255) NULL,                     -- comma-separated tags for MVP
  view_count INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_plans_status (status),
  INDEX idx_plans_category (category),
  CONSTRAINT fk_plans_user FOREIGN KEY (created_by) REFERENCES users(id)
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS plan_images (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  plan_id BIGINT NOT NULL,
  url VARCHAR(500) NOT NULL,
  alt_text VARCHAR(140) NULL,
  sort_order INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_plan_images_plan (plan_id),
  CONSTRAINT fk_plan_images_plan FOREIGN KEY (plan_id) REFERENCES plans(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 5) Experts
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS expert_profiles (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT NOT NULL UNIQUE,
  headline VARCHAR(140) NULL,
  bio TEXT NULL,
  experience_years INT NULL,
  skills VARCHAR(255) NULL,
  company VARCHAR(140) NULL,
  license_id VARCHAR(80) NULL,
  rating_avg DECIMAL(3,2) NOT NULL DEFAULT 0.00,
  rating_count INT NOT NULL DEFAULT 0,
  verified_by_admin BIGINT NULL,
  verified_at DATETIME NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT fk_expert_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  CONSTRAINT fk_expert_verified_by FOREIGN KEY (verified_by_admin) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 6) Projects (User build projects)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS projects (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  owner_id BIGINT NOT NULL,
  status ENUM('DRAFT','ACTIVE','ON_HOLD','COMPLETED','ARCHIVED') NOT NULL DEFAULT 'DRAFT',
  title VARCHAR(140) NOT NULL,
  description TEXT NULL,
  region VARCHAR(80) NULL,
  budget_currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  budget_amount DECIMAL(14,2) NULL,
  start_date DATE NULL,
  target_end_date DATE NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_projects_owner (owner_id),
  INDEX idx_projects_status (status),
  CONSTRAINT fk_projects_owner FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS project_members (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  project_id BIGINT NOT NULL,
  user_id BIGINT NOT NULL,
  member_role ENUM('OWNER','ENGINEER','CONTRACTOR','SUPPLIER','VIEWER') NOT NULL DEFAULT 'VIEWER',
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY uq_project_member (project_id, user_id),
  INDEX idx_project_members_project (project_id),
  CONSTRAINT fk_project_members_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE,
  CONSTRAINT fk_project_members_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 7) Uploads (plans, documents, images)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS uploads (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  uploaded_by BIGINT NOT NULL,
  entity_type ENUM('LISTING','PLAN','PROJECT','PROFILE','OTHER') NOT NULL DEFAULT 'OTHER',
  entity_id BIGINT NULL,
  file_type ENUM('IMAGE','PDF','DOC','OTHER') NOT NULL DEFAULT 'OTHER',
  mime_type VARCHAR(120) NULL,
  filename VARCHAR(255) NOT NULL,
  url VARCHAR(600) NOT NULL,
  size_bytes BIGINT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_uploads_uploader (uploaded_by),
  INDEX idx_uploads_entity (entity_type, entity_id),
  CONSTRAINT fk_uploads_user FOREIGN KEY (uploaded_by) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 8) Estimation + BOQ
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS estimates (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  created_by BIGINT NOT NULL,
  project_id BIGINT NULL,
  plan_id BIGINT NULL,
  title VARCHAR(140) NOT NULL,
  currency VARCHAR(10) NOT NULL DEFAULT 'RWF',
  subtotal DECIMAL(14,2) NOT NULL DEFAULT 0,
  contingency DECIMAL(14,2) NOT NULL DEFAULT 0,
  taxes DECIMAL(14,2) NOT NULL DEFAULT 0,
  total DECIMAL(14,2) NOT NULL DEFAULT 0,
  notes TEXT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_estimates_user (created_by),
  INDEX idx_estimates_project (project_id),
  CONSTRAINT fk_estimates_user FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE CASCADE,
  CONSTRAINT fk_estimates_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE SET NULL,
  CONSTRAINT fk_estimates_plan FOREIGN KEY (plan_id) REFERENCES plans(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS boq_items (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  estimate_id BIGINT NOT NULL,
  section VARCHAR(120) NULL,                  -- e.g., Substructure, Superstructure
  item_code VARCHAR(60) NULL,
  description VARCHAR(255) NOT NULL,
  unit VARCHAR(20) NULL,
  quantity DECIMAL(14,3) NOT NULL DEFAULT 0,
  unit_rate DECIMAL(14,2) NOT NULL DEFAULT 0,
  amount DECIMAL(14,2) NOT NULL DEFAULT 0,
  sort_order INT NOT NULL DEFAULT 0,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_boq_estimate (estimate_id),
  CONSTRAINT fk_boq_estimate FOREIGN KEY (estimate_id) REFERENCES estimates(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 9) AI Chat (Intelligence) + Guest 3-message limit
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS ai_threads (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT NULL,                        -- null means guest
  guest_id VARCHAR(80) NULL,                  -- store anonymous id (cookie/localStorage value)
  title VARCHAR(140) NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_ai_threads_user (user_id),
  INDEX idx_ai_threads_guest (guest_id),
  CONSTRAINT fk_ai_threads_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS ai_messages (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  thread_id BIGINT NOT NULL,
  role ENUM('user','assistant','system') NOT NULL,
  content MEDIUMTEXT NOT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_ai_messages_thread (thread_id),
  CONSTRAINT fk_ai_messages_thread FOREIGN KEY (thread_id) REFERENCES ai_threads(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Track guest usage (3 messages limit)
CREATE TABLE IF NOT EXISTS guest_chat_limits (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  guest_id VARCHAR(80) NOT NULL UNIQUE,
  message_count INT NOT NULL DEFAULT 0,
  first_seen_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  last_seen_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_guest_chat_guest (guest_id)
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 10) Audit logs (optional but useful)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS audit_logs (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  actor_user_id BIGINT NULL,
  action VARCHAR(80) NOT NULL,                -- e.g., LOGIN, CREATE_LISTING, PUBLISH_PLAN
  entity_type VARCHAR(40) NULL,               -- USERS/LISTINGS/PLANS/...
  entity_id BIGINT NULL,
  meta JSON NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_audit_actor (actor_user_id),
  INDEX idx_audit_action (action),
  CONSTRAINT fk_audit_actor FOREIGN KEY (actor_user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- =========================================================
-- END
-- =========================================================