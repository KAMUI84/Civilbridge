-- ---------------------------------------------------------
-- 6) Labor Rates (Regional)
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS labor_rates (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  region_id INT NOT NULL,
  skill_level ENUM('unskilled','skilled','specialist') NOT NULL,
  rate_per_day DECIMAL(14,2) NOT NULL,
  effective_from DATE NOT NULL DEFAULT (CURRENT_DATE),
  is_active TINYINT(1) NOT NULL DEFAULT 1,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY uq_region_skill (region_id, skill_level),
  CONSTRAINT fk_labor_region FOREIGN KEY (region_id) REFERENCES regions(id)
) ENGINE=InnoDB;

INSERT IGNORE INTO labor_rates (region_id, skill_level, rate_per_day) VALUES
