-- ---------------------------------------------------------
-- 16) Carbon Footprint
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS carbon_footprints (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  project_id BIGINT NULL,
  estimate_id BIGINT NULL,
  calculated_by BIGINT NOT NULL,
  total_co2_kg DECIMAL(14,2) NOT NULL DEFAULT 0,
  materials_co2_kg DECIMAL(14,2) NOT NULL DEFAULT 0,
  transport_co2_kg DECIMAL(14,2) NOT NULL DEFAULT 0,
  labor_co2_kg DECIMAL(14,2) NOT NULL DEFAULT 0,
  breakdown JSON NULL,
  offset_suggestions TEXT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_carbon_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE SET NULL,
  CONSTRAINT fk_carbon_estimate FOREIGN KEY (estimate_id) REFERENCES estimates(id) ON DELETE SET NULL,
  CONSTRAINT fk_carbon_user FOREIGN KEY (calculated_by) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 17) ROI Calculations
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS roi_calculations (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT NOT NULL,
  project_id BIGINT NULL,
  land_cost DECIMAL(14,2) NOT NULL DEFAULT 0,
  construction_cost DECIMAL(14,2) NOT NULL DEFAULT 0,
  other_costs DECIMAL(14,2) NOT NULL DEFAULT 0,
  total_investment DECIMAL(14,2) NOT NULL DEFAULT 0,
  projected_value DECIMAL(14,2) NOT NULL DEFAULT 0,
  monthly_rental DECIMAL(14,2) NULL,
  expected_years INT NOT NULL DEFAULT 10,
  roi_percent DECIMAL(8,2) NOT NULL DEFAULT 0,
  payback_years DECIMAL(8,2) NULL,
  notes TEXT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_roi_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
  CONSTRAINT fk_roi_project FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 18) AI Chat
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS ai_threads (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT NULL,
  guest_id VARCHAR(80) NULL,
  title VARCHAR(140) NULL,
  context_type ENUM('general','budget','estimation','plans','experts') NOT NULL DEFAULT 'general',
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_ai_threads_user (user_id),
  INDEX idx_ai_threads_guest (guest_id),
  CONSTRAINT fk_ai_threads_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS ai_messages (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  thread_id BIGINT NOT NULL,
  role ENUM('user','assistant','system') NOT NULL,
  content MEDIUMTEXT NOT NULL,
  tokens_used INT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_ai_messages_thread (thread_id),
  CONSTRAINT fk_ai_messages_thread FOREIGN KEY (thread_id) REFERENCES ai_threads(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE IF NOT EXISTS guest_chat_limits (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  guest_id VARCHAR(80) NOT NULL UNIQUE,
  message_count INT NOT NULL DEFAULT 0,
  first_seen_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  last_seen_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_guest_chat_guest (guest_id)
) ENGINE=InnoDB;

-- ---------------------------------------------------------
-- 19) Audit Logs
-- ---------------------------------------------------------
CREATE TABLE IF NOT EXISTS audit_logs (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  actor_user_id BIGINT NULL,
  action VARCHAR(80) NOT NULL,
  entity_type VARCHAR(40) NULL,
  entity_id BIGINT NULL,
  meta JSON NULL,
  ip_address VARCHAR(64) NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_audit_actor (actor_user_id),
  INDEX idx_audit_action (action),
  INDEX idx_audit_entity (entity_type, entity_id),
  CONSTRAINT fk_audit_actor FOREIGN KEY (actor_user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

SET FOREIGN_KEY_CHECKS = 1;

-- =========================================================
-- END
-- =========================================================