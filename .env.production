# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL="mysql://user:password@localhost:3306/civilbridge_prod"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-key-for-production-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# CORS Configuration
CORS_ORIGIN="https://civilbridge.rw,https://www.civilbridge.rw"
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@civilbridge.rw"
SMTP_PASS="your-app-password"

# Redis Configuration (for sessions/caching)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# Monitoring & Logging
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
SENTRY_DSN="your-sentry-dsn-for-error-tracking"

# Security
CSRF_SECRET="your-csrf-secret-key-min-32-chars"
BCRYPT_ROUNDS=12

# AI Service Configuration
GEMINI_API_KEY="your-gemini-api-key"
AI_RATE_LIMIT_PER_MINUTE=10
AI_GUEST_MESSAGE_LIMIT=3

# CDN Configuration (for static assets)
CDN_URL="https://cdn.civilbridge.rw"

# Analytics
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
